modules = ["nodejs-20", "postgresql-16"]
[deployment]
deploymentTarget = "gce"
build = "npm run build"
run = "npm start"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[agent]
integrations = ["javascript_database==1.0.0", "javascript_object_storage==1.0.0"]
